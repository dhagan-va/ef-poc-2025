# Local development secrets. Copy this file to `.env` (which is gitignored) and fill in the blanks.
# The same file feeds three consumers:
#   - the app and the integration tests   (loaded by AppConfiguration.Build via DotNetEnv)
#   - docker compose                       (auto-loaded for ${VAR} substitution and container env)
# Keys use the .NET double-underscore convention (Section__Key) so all three read them directly.

# EdiFabric license serial key (REQUIRED) — the one real secret. Get it from your EdiFabric account.
EdiFabric__SerialKey=

# SQL Server SA password. Used by the db container, the migrate/app containers, the host app, and the
# tests, so they all stay in sync. Must satisfy SQL Server password complexity rules.
SqlServer__Password=YourStrong@Passw0rd
